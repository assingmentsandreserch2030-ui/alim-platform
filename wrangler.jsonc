{
  "$schema": "node_modules/wrangler/config-schema.json",
  // اسم العامل في Cloudflare، يجب أن يبقى كما هو
  "name": "alim-platform",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // ملفات الموقع الثابتة (index.html و admin.html)، والملفات المستثناة في .assetsignore
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/files/*"]
  },
  // مخزن الملفات المرفوعة وبياناتها
  "kv_namespaces": [
    { "binding": "FILES", "id": "64b6848699ad444380aad00f2ef844d7" }
  ],
  // بصمة رمز الإعداد (وليست الرمز نفسه). بالرمز يختار المدير كلمة المرور من صفحة /admin أو يعيد تعيينها
  "vars": { "SETUP_CODE_HASH": "043b43703ee15ce60cf1ade30eea264062a3eedfb459804eac3df5da5adbd26a" },
  // اختياري: يمكن أيضًا وضع كلمة المرور كمتغير سري باسم ADMIN_PASSWORD من لوحة Cloudflare
  "keep_vars": true,
  "observability": { "enabled": true }
}
